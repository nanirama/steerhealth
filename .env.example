# --- Existing site configuration -------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_TITLE=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CDN_BASE_URL=
NEXT_DEVELOPMENT_ENV=

# --- RAG assistant (/rag) — all server-only; never prefix with NEXT_PUBLIC_ ---------------
# Required
GEMINI_API_KEY=
PINECONE_API_KEY=

# Models (defaults shown). Changing the embedding model or dimensions requires reindexing.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_CHAT_MODEL=gemini-2.5-flash
# 0 disables thinking on 2.5 models (faster, cheaper for grounded Q&A).
GEMINI_CHAT_THINKING_BUDGET=0
GEMINI_CHAT_TEMPERATURE=0.2
GEMINI_CHAT_MAX_OUTPUT_TOKENS=1024
# Independent evaluator model (must differ from the chat model).
GEMINI_JUDGE_MODEL=gemini-3.1-pro-preview
# Count query-embedding tokens with the countTokens API (parallel, off the critical path).
RAG_COUNT_EMBEDDING_TOKENS=true

# Pinecone. Namespace defaults to NEXT_PUBLIC_SANITY_DATASET so datasets never mix.
PINECONE_INDEX_NAME=steer-kb
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
# Only used by `npm run rag:ingest -- --create-index`.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Chunking and retrieval
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=12
RAG_MIN_SCORE=0.45
# Pinecone hosted reranker over the top RAG_RERANK_CANDIDATES matches ("none" disables).
RAG_RERANK_MODEL=bge-reranker-v2-m3
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TIMEOUT_MS=3000
RAG_MAX_SOURCES=6
RAG_MAX_CHUNKS_PER_DOC=2
RAG_MAX_CONTEXT_CHARS=12000

# Limits and timeouts
RAG_MAX_QUESTION_CHARS=1000
RAG_RATE_LIMIT_PER_MINUTE=20
RAG_EMBED_TIMEOUT_MS=8000
RAG_SEARCH_TIMEOUT_MS=5000
RAG_GENERATION_TIMEOUT_MS=45000
RAG_MAX_RETRIES=2

# Latency targets (warnings in the dashboard and benchmark)
RAG_LATENCY_TARGET_MS=4000
RAG_TTFT_TARGET_MS=1500

# Observability. LOG_DIR must be on a persistent volume in production.
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_MB=20
RAG_TRACE_SAMPLE_RATE=1
OTEL_SERVICE_NAME=steer-rag
# Optional OTLP/HTTP collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Evaluation
EVAL_RESULTS_DIR=evaluations/runs
RAG_EVAL_K=5
RAG_EVAL_MIN_RECALL=0.8
RAG_EVAL_MIN_MRR=0.6
RAG_EVAL_MIN_FAITHFULNESS=0.85
RAG_EVAL_MIN_CORRECTNESS=0.75
RAG_EVAL_MIN_ABSTENTION_ACCURACY=0.8
RAG_EVAL_MIN_CITATION_SUPPORT=0.85

# Optional pricing override (USD per 1M tokens), see src/lib/rag/cost.ts
# RAG_PRICING_JSON={"version":"2027-01","models":{"gemini-2.5-flash":{"inputPer1M":0.3,"outputPer1M":2.5}}}

# --- Admin dashboard (/admin) — server-side only ------------------------------------------
# Generate the hash with: npm run admin:hash-password   (never store the plaintext password)
# Local development: put these in .env.local (git-ignored). Production: a Kubernetes Secret.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
# Secure/__Host- cookies follow the request scheme (X-Forwarded-Proto); force with true|false.
ADMIN_COOKIE_SECURE=
# Extra allowed Origin for state-changing admin requests (defaults to the request host).
ADMIN_ALLOWED_ORIGIN=

# --- Telemetry store (conversations, requests, logs, traces, evaluations, audit) -----------
# SQLite file; must be on persistent storage in production (Kubernetes PVC).
RAG_DB_PATH=data/rag.db
# Transcript storage: redacted (default; emails/phones/keys/numbers masked) | full | off
RAG_TRANSCRIPT_MODE=redacted
RAG_TRANSCRIPT_RETENTION_DAYS=30
RAG_TELEMETRY_RETENTION_DAYS=90
# Minimum samples before a percentile is shown (otherwise "Insufficient samples")
RAG_MIN_SAMPLES_P50=5
RAG_MIN_SAMPLES_P95=20
RAG_MIN_SAMPLES_P99=100
