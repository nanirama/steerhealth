FROM node:24.2.0-slim

ARG NEXT_PUBLIC_SANITY_PROJECT_ID
ARG NEXT_PUBLIC_SANITY_DATASET
ARG SANITY_API_READ_TOKEN
ARG SANITY_API_WRITE_TOKEN
ARG SANITY_AUTH_TOKEN
ARG NEXT_PUBLIC_SANITY_PROJECT_TITLE
ARG NEXT_PUBLIC_SITE_URL
ARG SANITY_OUTPUT_PATH=/usr/src/app/studio

ENV NEXT_PUBLIC_SANITY_PROJECT_ID=$NEXT_PUBLIC_SANITY_PROJECT_ID
ENV NEXT_PUBLIC_SANITY_DATASET=$NEXT_PUBLIC_SANITY_DATASET
ENV SANITY_API_READ_TOKEN=$SANITY_API_READ_TOKEN
ENV SANITY_API_WRITE_TOKEN=$SANITY_API_WRITE_TOKEN
ENV SANITY_AUTH_TOKEN=$SANITY_AUTH_TOKEN
ENV NEXT_PUBLIC_SANITY_PROJECT_TITLE=$NEXT_PUBLIC_SANITY_PROJECT_TITLE
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NODE_OPTIONS="--max-old-space-size=4096"


WORKDIR /usr/src/app

COPY . .

COPY package*.json ./

RUN npm install

RUN npm run build

RUN npx sanity@latest init --project $PUBLIC_SANITY_STUDIO_PROJECT_ID --dataset $PUBLIC_SANITY_STUDIO_DATASET --output-path $SANITY_OUTPUT_PATH --yes

EXPOSE 3000

